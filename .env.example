# Application Environment Configuration

# Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# Server HTTP Port
PORT=3000

# Secret key used for signing session cookies (min 32 characters)
SESSION_SECRET=media_explorer_super_secret_session_key_32bytes_long

# Root Directory to browse (defaults to process.cwd())
ROOT_DIR=/sdcard

# Require login authentication ('true' | 'false')
REQUIRE_LOGIN=false

# Session timeout in seconds (default: 8 hours = 28800)
SESSION_TIMEOUT=28800

# Rate limiting: max requests per minute per IP
RATE_LIMIT_MAX=100

# Rate limiting: max login attempts per 15 minutes per IP
LOGIN_RATE_LIMIT=5

# Users config list: comma-separated "username:hash" pairs
# Example with bcrypt hash for 'admin123':
USERS=admin:$2a$10$8.UnVuG9HHgffUDAlk8qfOUVGkqRzgVym524.3pSnyMml08269h.S

# Application Branding Title
APP_NAME=Media Explorer

# Debug logging enabled
APP_DEBUG=false
